# MongoDB Connection - Set in Vercel environment variables
MONGODB_URI=

# Environment
NODE_ENV=production

# CORS - Set to your Vercel domain
CORS_ORIGIN=https://your-vercel-app.vercel.app

# Frontend API URL - Set to your Vercel API endpoint
VITE_API_BASE_URL=https://your-vercel-app.vercel.app/api
